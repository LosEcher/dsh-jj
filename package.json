{
  "name": "dsh-jj",
  "version": "1.0.0",
  "type": "module",
  "description": "DSH bundle: jj (Jujutsu) version control via a zero-dependency MCP stdio server — exposes jj status/log/diff/describe/new/commit/edit/abandon/undo/rebase/fetch/push/bookmark as mcp__jj__* tools.",
  "repository": {
    "type": "git",
    "url": "https://github.com/LosEcher/dsh-jj.git"
  },
  "bin": {
    "jj-mcp": "server.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/test-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "server.mjs",
    "cordis.patch.yml",
    "README.md",
    "test/test-client.mjs"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0"
  },
  "license": "MIT"
}
